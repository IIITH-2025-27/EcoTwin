# ══════════════════════════════════════════════════════════════════════════════
# EcoTwin Backend — Environment Variables
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="EcoTwin API"
APP_VERSION="1.0.0"
# Set to true in development to enable debug logging and stub ML inference
DEBUG=false
ENVIRONMENT=production

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Use "postgres" as host when running inside Docker Compose; "localhost" locally
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecotwin
POSTGRES_USER=ecotwin
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD          # REQUIRED — never use default in production

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use "redis" as host inside Docker Compose; "localhost" locally
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                                 # leave empty if no AUTH configured
REDIS_TTL=86400                                 # default cache TTL in seconds (24 h)

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET  # REQUIRED — generate with: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440                # 24 hours

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Similarity Search ─────────────────────────────────────────────────────────
DEFAULT_TOP_K=10
MAX_TOP_K=50
SIMILARITY_TARGET_MS=500

# ── Reports ───────────────────────────────────────────────────────────────────
REPORTS_STORAGE_PATH=/app/reports

# ── Object Storage (optional — for S3-backed PDF reports) ────────────────────
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── ML Pipeline — Prithvi-100M ────────────────────────────────────────────────
# Path to a local .pt checkpoint inside the container.
# The `prithvi_model` Docker volume is mounted at /app/models.
# Leave as-is; if the file is absent the worker auto-downloads from HuggingFace
# (~400 MB, cached in the `hf_cache` volume — one-time download).
PRITHVI_MODEL_PATH=/app/models/prithvi_100m.pt

# Set to true to skip model loading entirely and return deterministic stub
# vectors. Useful for local development without a GPU or model weights.
# Automatically forced true when DEBUG=true.
PRITHVI_USE_STUB=false

# ── ML Pipeline — Google Earth Engine ────────────────────────────────────────
# Option A (local dev): run `earthengine authenticate` once — leave both empty.
# Option B (Docker / production): create a GEE-enabled service account, download
# the JSON key, mount it into the container, and fill in the values below.
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=/app/secrets/gee_key.json               # e.g. /app/secrets/gee_key.json

# ── ML Pipeline — Ecosystem Classifier ───────────────────────────────────────
# Optional path to a serialised scikit-learn model (.pkl) used as a learned
# classification head (Stage B). Leave empty to use the built-in rule-based
# classifier (Stage A — no extra file needed).
CLASSIFIER_MODEL_PATH=

# ── Data Sync ─────────────────────────────────────────────────────────────────
# Directory where pg_dump backup files are written during backup-mode syncs.
# The `sync_backups` Docker volume is mounted here.
BACKUP_DIR=/app/backups

# Boundary file used to assign each imported HydroLAKES centroid to an Indian
# state or union territory. Supports .shp and GeoJSON FeatureCollection files.
INDIA_STATES_SOURCE_PATH=app/state_data/geoBoundaries-IND-ADM1.geojson

# ── Lake processing grid ─────────────────────────────────────────────────────
# Each valid lake cell is 1 km × 1 km. Cells with less lake coverage are skipped.
LAKE_GRID_CELL_SIZE_METRES=1000
LAKE_GRID_MIN_COVERAGE_PERCENT=15
